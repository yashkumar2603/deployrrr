PORT=3000
DEPLOYRRR_BASE_DOMAIN=deployrrr.example.com
DEPLOYRRR_PUBLIC_BUCKET=deployrrr-public-previews
DEPLOYRRR_PUBLIC_REGION=auto
DEPLOYRRR_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
DEPLOYRRR_PUBLIC_ACCESS_KEY_ID=<access-key-id>
DEPLOYRRR_PUBLIC_SECRET_ACCESS_KEY=<secret-access-key>
DEPLOYRRR_PUBLIC_FORCE_PATH_STYLE=true
DEPLOYRRR_PUBLIC_PREFIX=sites
DEPLOYRRR_UPLOAD_URL_TTL_SECONDS=900
